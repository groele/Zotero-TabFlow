zotero-tabflow-settings-heading = Zotero TabFlow
zotero-tabflow-version-badge = v{ $version }
zotero-tabflow-settings-intro = Unified tab grouping, pinned tabs, tab sleep, remarks, workspace sessions, collection auto-grouping, and Spotlight search. Every feature can be toggled independently below.
zotero-tabflow-card-layout-heading = 1. Tab Bar Layout & Core Features
zotero-tabflow-card-layout-intro = Choose which tab organization surfaces and persistence capabilities are enabled.
zotero-tabflow-pref-enable-horizontal-groups =
    .label = Enable horizontal grouped tab bar
zotero-tabflow-pref-enable-horizontal-groups-desc = Render collapsible colored group capsules directly in the top tab bar.
zotero-tabflow-pref-enable-vertical-sidebar =
    .label = Enable vertical tabs sidebar
zotero-tabflow-pref-enable-vertical-sidebar-desc = Show a collapsible left sidebar with Custom Groups, Collections, and Recent/Status views.
zotero-tabflow-pref-enable-pinned-tabs =
    .label = Enable pinned tabs
zotero-tabflow-pref-enable-pinned-tabs-desc = Pin important papers to the front; pinned tabs are protected from accidental closing, sleep, and stale cleanup.
zotero-tabflow-pref-enable-virtual-members =
    .label = Keep closed grouped tabs as virtual members
zotero-tabflow-pref-enable-virtual-members-desc = Retain group membership after closing a reader tab so you can reload it with one click later.
zotero-tabflow-pref-enable-collection-autogroup =
    .label = Auto-group newly opened tabs by Zotero collection
zotero-tabflow-pref-enable-collection-autogroup-desc = Automatically assign newly opened PDFs or notes to a group matching their collection.
zotero-tabflow-pref-multi-collection-strategy = Multi-collection assignment rule
zotero-tabflow-strategy-active = Prefer currently selected collection
zotero-tabflow-strategy-existing = Prefer an existing matching group
zotero-tabflow-strategy-first = Use first assigned collection
zotero-tabflow-card-display-heading = 2. Remarks, Typography & Hover Preview
zotero-tabflow-pref-enable-tab-remarks =
    .label = Enable custom tab remarks (aliases)
zotero-tabflow-pref-enable-tab-remarks-desc = Add up to 300-character custom notes to tabs without modifying original PDF filenames.
zotero-tabflow-pref-remark-display-mode = Default remark display mode
zotero-tabflow-display-both = Remark + Title
zotero-tabflow-display-note = Remark only
zotero-tabflow-display-original = Original title / filename
zotero-tabflow-pref-enable-hover-preview =
    .label = Enable hover metadata preview card in sidebar
zotero-tabflow-pref-enable-hover-preview-desc = Show full title, authors, publication, collection, last-read time, and remark on hover.
zotero-tabflow-pref-vertical-typography = Vertical Sidebar Typography
zotero-tabflow-pref-title-mode = Primary title
zotero-tabflow-title-full = Full title
zotero-tabflow-title-short = Short title
zotero-tabflow-title-filename = Attachment filename
zotero-tabflow-pref-subtitle-mode = Subtitle
zotero-tabflow-subtitle-source = Source (Journal / Venue)
zotero-tabflow-subtitle-creator-year = Authors & Year
zotero-tabflow-subtitle-collection = Zotero Collection
zotero-tabflow-subtitle-none = None
zotero-tabflow-pref-row-height = Row height (px, min 32)
zotero-tabflow-pref-font-size = Font size (px, min 10)
zotero-tabflow-card-productivity-heading = 3. Spotlight, Sessions, Sleep & Cleanup
zotero-tabflow-pref-enable-spotlight =
    .label = Enable Spotlight quick switcher (Ctrl+P)
zotero-tabflow-pref-enable-spotlight-desc = Press Ctrl+P (or Cmd+P) anywhere to search open/virtual tabs, remarks, collections, and quick commands.
zotero-tabflow-pref-enable-sessions =
    .label = Enable workspace sessions
zotero-tabflow-pref-enable-sessions-desc = Save and restore named snapshots of your tab groups and open papers.
zotero-tabflow-pref-enable-tab-sleep =
    .label = Enable reader tab sleep (memory saver)
zotero-tabflow-pref-enable-tab-sleep-desc = Suspend inactive background reader tabs to free memory while keeping them in place for instant wake-up.
zotero-tabflow-pref-enable-stale-suggestions =
    .label = Enable stale tab cleanup suggestions
zotero-tabflow-pref-enable-stale-suggestions-desc = Track last-viewed timestamps and list tabs unread beyond the day threshold.
zotero-tabflow-pref-stale-days = Stale threshold (days, 1-3650)
zotero-tabflow-card-menus-heading = 4. Context Menu Enhancements
zotero-tabflow-pref-enable-tab-context-menu =
    .label = Enable tab context menu enhancements
zotero-tabflow-pref-enable-copy-reference =
    .label = Copy citation to clipboard
zotero-tabflow-pref-enable-show-in-filesystem =
    .label = Show attachment in filesystem
zotero-tabflow-pref-enable-reload-tab =
    .label = Reload tab
zotero-tabflow-pref-enable-item-context-menu =
    .label = Enable library item "Open & Group" menu
zotero-tabflow-pref-enable-item-context-menu-desc = Right-click selected library items to open them directly into a new or existing tab group.
zotero-tabflow-pref-enable-pdf-folder-sidenav =
    .label = Show "Open PDF Folder" icon in right Item Pane sidenav
zotero-tabflow-pref-enable-pdf-folder-sidenav-desc = Add a one-click folder icon to Zotero's right-hand item pane sidenav to open the PDF attachment's folder.
zotero-tabflow-pdf-folder-title =
    .label = Open PDF Folder
    .tooltiptext = Open PDF attachment folder
zotero-tabflow-pdf-folder-sidenav =
    .tooltiptext = Open PDF attachment folder
zotero-tabflow-card-maintenance-heading = 5. Diagnostics & Data Reset
zotero-tabflow-pref-debug =
    .label = Enable debug logging
zotero-tabflow-pref-debug-desc = Write detailed TabFlow lifecycle and sync logs to Zotero Error Console.
zotero-tabflow-reset-prefs-heading = Reset Preferences
zotero-tabflow-reset-prefs-desc = Restore all TabFlow toggles and display options to their defaults.
zotero-tabflow-reset-prefs-btn =
    .label = Restore Defaults
zotero-tabflow-clear-state-heading = Clear Workspace State
zotero-tabflow-clear-state-desc = Clear all saved groups, remarks, pinned tabs, sessions, and activity history.
zotero-tabflow-clear-state-btn =
    .label = Clear Data
zotero-tabflow-pdf-folder-open = Open PDF folder
zotero-tabflow-pdf-folder-unavailable = No file attachment for this item
zotero-tabflow-pinned-strip =
    .aria-label = Pinned tabs
zotero-tabflow-pref-enable-batch-selection =
    .label = Enable sidebar multi-selection
zotero-tabflow-batch-toggle = Select
zotero-tabflow-batch-count = Selected: { $count }
zotero-tabflow-batch-select-visible = Select visible
zotero-tabflow-batch-group-label =
    .aria-label = Move selected tabs to group
zotero-tabflow-batch-move = Move to group…
zotero-tabflow-batch-pin = Pin
zotero-tabflow-batch-unpin = Unpin
zotero-tabflow-spotlight-search =
    .placeholder = Search open tabs, type >tabs to sort by recency, or type > for commands
