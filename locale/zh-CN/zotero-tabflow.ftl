zotero-tabflow-pref-font-size = 文字大小（像素，最低 10）
zotero-tabflow-card-productivity-heading = 3. Spotlight 搜索、会话快照、休眠与清理
zotero-tabflow-pref-enable-spotlight =
    .label = 启用 Spotlight 全局快速搜索（Ctrl+P）
zotero-tabflow-pref-enable-spotlight-desc = 在任意界面按 Ctrl+P（macOS 为 Cmd+P）检索已开/虚拟标签、备注、集合与快捷命令。
zotero-tabflow-pref-enable-sessions =
    .label = 启用工作区会话快照
zotero-tabflow-pref-enable-sessions-desc = 保存与一键恢复整套分组与已打开文献的工作区快照。
zotero-tabflow-pref-enable-tab-sleep =
    .label = 启用阅读器标签休眠（释放内存）
zotero-tabflow-pref-enable-tab-sleep-desc = 将后台未使用的阅读器标签挂起释放内存，保留在分组中点击秒唤醒。
zotero-tabflow-pref-enable-stale-suggestions =
    .label = 启用久未查看标签清理建议
zotero-tabflow-pref-enable-stale-suggestions-desc = 自动记录文献查看时间，并汇总超过阈值的久未查看标签。
zotero-tabflow-pref-stale-days = 久未查看天数阈值（1-3650）
zotero-tabflow-card-menus-heading = 4. 右键菜单增强
zotero-tabflow-pref-enable-tab-context-menu =
    .label = 启用标签页右键菜单增强
zotero-tabflow-pref-enable-copy-reference =
    .label = 右键：复制引用到剪贴板
zotero-tabflow-pref-enable-show-in-filesystem =
    .label = 右键：在文件管理器中显示附件
zotero-tabflow-pref-enable-reload-tab =
    .label = 右键：重新加载标签页
zotero-tabflow-pref-enable-item-context-menu =
    .label = 启用文献库条目右键「打开并分组」
zotero-tabflow-pref-enable-item-context-menu-desc = 在文献库列表右键选中条目时，可直接打开到新建或已有分组。
zotero-tabflow-pref-enable-pdf-folder-sidenav =
    .label = 在右侧条目详情侧边栏显示「打开 PDF 文件夹」图标
zotero-tabflow-pref-enable-pdf-folder-sidenav-desc = 在 Zotero 右侧边栏图标列添加一键跳转当前 PDF 附件所在文件夹的快捷入口。
