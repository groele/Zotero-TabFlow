zotero-tabflow-settings-heading = Zotero TabFlow
zotero-tabflow-version-badge = v{ $version }
zotero-tabflow-settings-intro = 融合水平与垂直标签分组、固定标签、休眠省内存、备注别名、工作区会话、集合自动归组与 Spotlight 极速搜索。所有功能均可在下方按需开启或关闭。
zotero-tabflow-card-layout-heading = 1. 标签栏布局与核心功能开关
zotero-tabflow-card-layout-intro = 自由选择需要启用的标签组织界面与分组持久化能力。
zotero-tabflow-pref-enable-horizontal-groups =
    .label = 启用水平标签分组栏
zotero-tabflow-pref-enable-horizontal-groups-desc = 在顶部原生标签栏直接渲染可折叠的彩色分组胶囊与未分组区。
zotero-tabflow-pref-enable-vertical-sidebar =
    .label = 启用垂直标签侧边栏
zotero-tabflow-pref-enable-vertical-sidebar-desc = 在主窗口左侧显示可折叠侧边栏，支持自定义分组、文库文件夹、最近与状态视图。
zotero-tabflow-pref-enable-pinned-tabs =
    .label = 启用固定标签（📌）
zotero-tabflow-pref-enable-pinned-tabs-desc = 将重要文献固定在最前，防误关，且自动跳过后台休眠与久未查看清理。
zotero-tabflow-pref-enable-virtual-members =
    .label = 关闭已分组标签后保留为「虚拟成员」
zotero-tabflow-pref-enable-virtual-members-desc = 关闭阅读器标签页后仍在分组中保留引用，下次可一键重新加载。
zotero-tabflow-pref-enable-collection-autogroup =
    .label = 打开新文献时按 Zotero 集合自动归组
zotero-tabflow-pref-enable-collection-autogroup-desc = 打开 PDF 或笔记时，自动将其归入对应文献集合的分组。
zotero-tabflow-pref-multi-collection-strategy = 文献同属多个集合时的归组规则
zotero-tabflow-strategy-active = 优先归入当前正在浏览的集合
zotero-tabflow-strategy-existing = 若已有匹配分组则归入已有分组
zotero-tabflow-strategy-first = 按所属集合列表首个集合归组
zotero-tabflow-card-display-heading = 2. 标签备注、排版与悬停预览
zotero-tabflow-pref-enable-tab-remarks =
    .label = 启用标签自定义备注（别名）
zotero-tabflow-pref-enable-tab-remarks-desc = 为标签添加最多 300 字符的备注，不修改原 PDF 文件名。
zotero-tabflow-pref-remark-display-mode = 默认备注显示模式
zotero-tabflow-display-both = 备注 + 原标题
zotero-tabflow-display-note = 仅显示备注
zotero-tabflow-display-original = 仅显示原标题/文件名
zotero-tabflow-pref-enable-hover-preview =
    .label = 启用侧栏悬停阅读信息预览卡片
zotero-tabflow-pref-enable-hover-preview-desc = 鼠标悬停时浮现完整标题、作者、刊名、所属集合、上次阅读时间与备注。
zotero-tabflow-pref-vertical-typography = 垂直侧栏排版设置
zotero-tabflow-pref-title-mode = 主标题内容
zotero-tabflow-title-full = 文献完整标题
zotero-tabflow-title-short = 文献短标题
zotero-tabflow-title-filename = 附件文件名
zotero-tabflow-pref-subtitle-mode = 副标题内容
zotero-tabflow-subtitle-source = 来源（期刊 / 会议 / 书籍）
zotero-tabflow-subtitle-creator-year = 作者与年份
zotero-tabflow-subtitle-collection = 所属 Zotero 集合
zotero-tabflow-subtitle-none = 不显示
zotero-tabflow-pref-row-height = 标签行高（像素，最低 32）
zotero-tabflow-pref-font-size = 文字大小（像素，最低 10）
zotero-tabflow-card-productivity-heading = 3. Spotlight 搜索、会话快照、休眠与清理
zotero-tabflow-pref-enable-spotlight =
    .label = 启用 Spotlight 全局快速搜索（Ctrl+P）
zotero-tabflow-pref-enable-spotlight-desc = 在任意界面按 Ctrl+P（macOS 为 Cmd+P）检索已开/虚拟标签、备注、集合与快捷命令。
zotero-tabflow-pref-enable-sessions =
    .label = 启用工作区会话快照
zotero-tabflow-pref-enable-sessions-desc = 保存与一键恢复整套分组与已打开文献的工作区快照。
zotero-tabflow-pref-enable-tab-sleep =
    .label = 启用阅读器标签休眠（释放内存）
zotero-tabflow-pref-enable-tab-sleep-desc = 将后台未使用的阅读器标签挂起释放内存，保留在分组中点击秒唤醒。
zotero-tabflow-pref-enable-stale-suggestions =
    .label = 启用久未查看标签清理建议
zotero-tabflow-pref-enable-stale-suggestions-desc = 自动记录文献查看时间，并汇总超过阈值的久未查看标签。
zotero-tabflow-pref-stale-days = 久未查看天数阈值（1-3650）
zotero-tabflow-card-menus-heading = 4. 右键菜单增强
zotero-tabflow-pref-enable-tab-context-menu =
    .label = 启用标签页右键菜单增强
zotero-tabflow-pref-enable-copy-reference =
    .label = 右键：复制引用到剪贴板
zotero-tabflow-pref-enable-show-in-filesystem =
    .label = 右键：在文件管理器中显示附件
zotero-tabflow-pref-enable-reload-tab =
    .label = 右键：重新加载标签页
zotero-tabflow-pref-enable-item-context-menu =
    .label = 启用文献库条目右键「打开并分组」
zotero-tabflow-pref-enable-item-context-menu-desc = 在文献库列表右键选中条目时，可直接打开到新建或已有分组。
zotero-tabflow-pref-enable-pdf-folder-sidenav =
    .label = 在右侧条目详情侧边栏显示「打开 PDF 文件夹」图标
zotero-tabflow-pref-enable-pdf-folder-sidenav-desc = 在 Zotero 右侧边栏图标列添加一键跳转当前 PDF 附件所在文件夹的快捷入口。
zotero-tabflow-pdf-folder-title =
    .label = 打开 PDF 文件夹
    .tooltiptext = 打开当前 PDF 附件所在文件夹
zotero-tabflow-pdf-folder-sidenav =
    .tooltiptext = 一键打开当前 PDF 附件所在文件夹
zotero-tabflow-card-maintenance-heading = 5. 诊断调试与数据重置
zotero-tabflow-pref-debug =
    .label = 启用调试日志
zotero-tabflow-pref-debug-desc = 将 TabFlow 生命周期与同步日志输出到 Zotero 错误控制台。
zotero-tabflow-reset-prefs-heading = 恢复默认设置
zotero-tabflow-reset-prefs-desc = 将所有 TabFlow 功能开关与显示参数重置为默认值。
zotero-tabflow-reset-prefs-btn =
    .label = 恢复默认设置
zotero-tabflow-clear-state-heading = 清除工作区数据
zotero-tabflow-clear-state-desc = 清除所有已保存的分组、备注、固定标签、会话快照与访问记录。
zotero-tabflow-clear-state-btn =
    .label = 清除工作区数据
zotero-tabflow-pdf-folder-open = 打开 PDF 所在文件夹
zotero-tabflow-pdf-folder-unavailable = 当前条目没有文件附件
zotero-tabflow-pinned-strip =
    .aria-label = 固定标签
zotero-tabflow-pref-enable-batch-selection =
    .label = 启用侧栏多选整理
zotero-tabflow-batch-toggle = 多选
zotero-tabflow-batch-count = 已选 { $count } 个
zotero-tabflow-batch-select-visible = 全选可见项
zotero-tabflow-batch-group-label =
    .aria-label = 将所选标签移入分组
zotero-tabflow-batch-move = 移到分组…
zotero-tabflow-batch-pin = 固定
zotero-tabflow-batch-unpin = 取消固定
zotero-tabflow-spotlight-search =
    .placeholder = 搜索已打开标签，输入 >tabs 按最近访问排序，或输入 > 查找命令
