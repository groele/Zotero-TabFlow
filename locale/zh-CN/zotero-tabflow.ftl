zotero-tabflow-settings-heading = Zotero TabFlow
zotero-tabflow-version-badge = v{ $version }
zotero-tabflow-settings-intro = 融合水平与垂直标签分组、固定标签、休眠省内存、备注别名、工作区会话、集合自动归组与 Spotlight 极速搜索。所有功能均可在下方按需开启或关闭。
zotero-tabflow-card-layout-heading = 1. 标签栏布局与核心功能开关
zotero-tabflow-card-layout-intro = 自由选择需要启用的标签组织界面与分组持久化能力。
zotero-tabflow-pref-enable-horizontal-groups =
    .label = 启用水平标签分组栏
zotero-tabflow-pref-enable-horizontal-groups-desc = 在顶部原生标签栏直接渲染可折叠的彩色分组胶囊与未分组区。
zotero-tabflow-pref-enable-vertical-sidebar =
    .label = 启用垂直标签侧边栏
zotero-tabflow-pref-enable-vertical-sidebar-desc = 在主窗口左侧显示可折叠侧边栏，支持自定义分组、文库文件夹、最近与状态视图。
zotero-tabflow-pref-enable-pinned-tabs =
    .label = 启用固定标签（📌）
zotero-tabflow-pref-enable-pinned-tabs-desc = 将重要文献固定在最前，防误关，且自动跳过后台休眠与久未查看清理。
zotero-tabflow-pref-enable-virtual-members =
    .label = 关闭已分组标签后保留为「虚拟成员」
zotero-tabflow-pref-enable-virtual-members-desc = 关闭阅读器标签页后仍在分组中保留引用，下次可一键重新加载。
zotero-tabflow-pref-new-tab-mode = 新标签归组方式
zotero-tabflow-new-tab-independent =
    .label = 独立标签（手动拖入分组）
zotero-tabflow-new-tab-collection =
    .label = 按文献集合自动归组
zotero-tabflow-pref-new-tab-mode-desc = 独立模式下，新开的 PDF 和笔记直接显示为独立标签。将标签拖到分组标题可手动归组。已有分组归属会保留。
zotero-tabflow-pref-multi-collection-strategy = 文献同属多个集合时的归组规则
zotero-tabflow-strategy-active =
    .label = 优先归入当前正在浏览的集合
zotero-tabflow-strategy-existing =
    .label = 若已有匹配分组则归入已有分组
zotero-tabflow-strategy-first =
    .label = 按所属集合列表首个集合归组
zotero-tabflow-card-display-heading = 2. 标签备注、排版与悬停预览
zotero-tabflow-pref-enable-tab-remarks =
    .label = 启用标签自定义备注（别名）
zotero-tabflow-pref-enable-tab-remarks-desc = 为标签添加最多 300 字符的备注，不修改原 PDF 文件名。
zotero-tabflow-pref-remark-display-mode = 默认备注显示模式
zotero-tabflow-display-both =
    .label = 备注 + 原标题
zotero-tabflow-display-note =
    .label = 仅显示备注
zotero-tabflow-display-original =
    .label = 仅显示原标题/文件名
zotero-tabflow-remark-mode-both = 备注 + 原标题
zotero-tabflow-remark-mode-note = 仅显示备注
zotero-tabflow-remark-mode-original = 仅显示原标题
