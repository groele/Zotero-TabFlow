{
  "manifest_version": 2,
  "name": "Zotero TabFlow",
  "version": "17.11.0",
  "description": "Unified horizontal & vertical tab grouping, pinned tabs, tab sleep, remarks, sessions, collection auto-grouping, and Spotlight search for Zotero.",
  "homepage_url": "https://github.com/groele/Zotero-TabFlow",
  "applications": {
    "zotero": {
      "id": "zotero-tabflow@groele",
      "strict_min_version": "10.0",
      "strict_max_version": "12.*",
      "update_url": "https://raw.githubusercontent.com/groele/Zotero-TabFlow/main/update.json"
    }
  },
  "icons": {
    "32": "tabflow.svg",
    "64": "tabflow.svg"
  }
}
